APP_NAME=DevOps AI Platform API
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/devops_ai_platform
JWT_SECRET_KEY=generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
